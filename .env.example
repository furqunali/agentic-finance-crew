# Copy to `.env` and fill in only if you want the REAL CrewAI engine.
# With everything unset, the app runs the deterministic local engine (no keys).

# --- Database ---------------------------------------------------------------
# Where decisions are persisted. Defaults to a local SQLite file if unset.
# For production, point at Postgres and `pip install -e ".[postgres]"`:
#   DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/finance_crew
# DATABASE_URL=sqlite:///./finance_crew.db

# Turn on the real multi-agent crew
USE_CREWAI=false

# LLM provider: "openai" or "gemini"
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# Provide the key for your chosen provider (never commit the real .env)
OPENAI_API_KEY=your-openai-key
# GEMINI_API_KEY=your-gemini-key
